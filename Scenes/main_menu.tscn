[node name="Help Text" type="Label" parent="MarginContainer2"]
layout_mode = 2
text = "* WASD/Space for movement
* alt/shift/ctrl/Mouse2 for spell menu (hold/toggle option in top left)
* Hold Mouse1 on crystal and release on wanted mode for spell mods
* Mouse1 for casting prepared spells

* Use aoe ground spell with matching color to get rid of shields
* Use spell with dmg mod or projectile spell with matching color to hit enemies"

